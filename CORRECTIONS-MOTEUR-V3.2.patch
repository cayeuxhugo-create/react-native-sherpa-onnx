-  private fun markUploaded(
-    tableName: String,
-    eventIds: List<String>,
-    eventLabel: String
-  ) {
-    val validEventIds =
-      eventIds
-        .asSequence()
-        .map { it.trim() }
-        .filter { it.isNotBlank() }
-        .distinct()
-        .toList()
-
-    if (validEventIds.isEmpty()) {
-      return
-    }
-
-    val database =
-      writableDatabase
-
-    database.beginTransaction()
-
-    try {
-      validEventIds
-        .chunked(
-          SQL_BATCH_SIZE
-        )
-        .forEach { eventIdBatch ->
-          markBatchUploaded(
-            database = database,
-            tableName = tableName,
-            eventIds = eventIdBatch
-          )
-        }
-
-      cleanupUploadedEvents(
-        database = database,
-        tableName = tableName,
-        eventLabel = eventLabel
-      )
-
-      database.setTransactionSuccessful()
-    } finally {
-      database.endTransaction()
-    }
-  }
-
-  private fun markBatchUploaded(
-    database: SQLiteDatabase,
-    tableName: String,
-    eventIds: List<String>
-  ) {
-    if (eventIds.isEmpty()) {
-      return
-    }
-
-    val placeholders =
-      eventIds.joinToString(",") {
-        "?"
-      }
-
-    database.execSQL(
-      """
-      UPDATE $tableName
-      SET uploaded = 1
-      WHERE uploaded = 0
-        AND id IN ($placeholders)
-      """.trimIndent(),
-      eventIds.toTypedArray()
-    )
-  }
-
-  private fun cleanupUploadedEvents(
-    database: SQLiteDatabase,
-    tableName: String,
-    eventLabel: String
-  ) {
-    val totalCount =
-      getTotalCount(
-        database = database,
-        tableName = tableName
-      )
-
-    if (
-      totalCount <=
-      MAX_STORED_EVENTS
-    ) {
-      return
-    }
-
-    val numberToDelete =
-      totalCount -
-        TARGET_STORED_EVENTS
-
-    if (numberToDelete <= 0) {
-      return
-    }
-
-    database.execSQL(
-      """
-      DELETE FROM $tableName
-      WHERE id IN (
-        SELECT id
-        FROM $tableName
-        WHERE uploaded = 1
-        ORDER BY recorded_at ASC
-        LIMIT ?
-      )
-      """.trimIndent(),
-      arrayOf(
-        numberToDelete
-      )
-    )
-
-    Log.d(
-      TAG,
-      "Nettoyage SQLite $eventLabel demandé : " +
-        "maximum=$numberToDelete événements uploadés"
-    )
-  }
-
-  private fun getTotalCount(
-    database: SQLiteDatabase,
-    tableName: String
-  ): Int {
-    database.rawQuery(
-      """
-      SELECT COUNT(*)
-      FROM $tableName
-      """.trimIndent(),
-      null
-    ).use { cursor ->
-      return if (cursor.moveToFirst()) {
-        cursor.getInt(0)
-      } else {
-        0
-      }
-    }
-  }

+  private suspend fun uploadEncodedBatch(
+    encodedBatch:
+      GuardianEventBatchEncoder.EncodedBatch,
+    markUploaded: (List<String>) -> Unit
+  ): BatchResult {
+    val tokens =
+      GuardianNativeAuthProvider
+        .getTokens(
+          forceRefresh = false
+        )
+
+    Log.d(
+      LOG_TAG,
+      "Envoi batch ${encodedBatch.batchId} (${encodedBatch.eventIds.size} événements)"
+    )
+
+    val response =
+      GuardianApiClient
+        .uploadEventBatch(
+          jsonBody =
+            encodedBatch.json,
+
+          authToken =
+            tokens.authToken,
+
+          appCheckToken =
+            tokens.appCheckToken
+        )
+
+    val firstResult =
+      handleApiResponse(
+        response = response,
+        expectedEventIds =
+          encodedBatch.eventIds,
+        markUploaded =
+          markUploaded
+      )
+
+    if (
+      firstResult.resultType !=
+      BatchResultType.AUTH_RETRY
+    ) {
+      return firstResult
+    }
+
+    return retryBatchWithFreshTokens(
+      expectedEventIds =
+        encodedBatch.eventIds,
+      jsonBody =
+        encodedBatch.json,
+      markUploaded =
+        markUploaded
+    )
+  }
+
+  private suspend fun retryBatchWithFreshTokens(
+    expectedEventIds: List<String>,
+    jsonBody: String,
+    markUploaded: (List<String>) -> Unit
+  ): BatchResult {
+    Log.w(
+      LOG_TAG,
+      "Renouvellement des jetons Firebase demandé"
+    )
+
+    val refreshedTokens =
+      GuardianNativeAuthProvider
+        .getTokens(
+          forceRefresh = true
+        )
+
+    val refreshedResponse =
+      GuardianApiClient
+        .uploadEventBatch(
+          jsonBody = jsonBody,
+          authToken =
+            refreshedTokens.authToken,
+          appCheckToken =
+            refreshedTokens.appCheckToken
+        )
+
+    return handleApiResponse(
+      response = refreshedResponse,
+      expectedEventIds =
+        expectedEventIds,
+      markUploaded =
+        markUploaded
+    )
+  }
+
+  private fun handleApiResponse(
+    response: GuardianApiClient.UploadResponse,
+    expectedEventIds: List<String>,
+    markUploaded: (List<String>) -> Unit
+  ): BatchResult {
+    Log.d(
+      LOG_TAG,
+      "Réponse API Guardian : " +
+        "status=${response.statusCode}, " +
+        "requestId=${response.requestId}"
+    )
+
+    if (!response.successful) {
+      return handleHttpFailure(
+        statusCode =
+          response.statusCode,
+        responseBody =
+          response.body
+      )
+    }
+
+    val responseBody =
+      response.body
+        ?.takeIf {
+          it.isNotBlank()
+        }
+        ?: run {
+          Log.e(
+            LOG_TAG,
+            "Réponse API vide malgré un statut réussi"
+          )
+
+          return BatchResult.retry()
+        }
+
+    val acceptedEventIds =
+      parseAcceptedEventIds(
+        responseBody
+      )
+
+    val expectedIdSet =
+      expectedEventIds.toSet()
+
+    val validAcceptedIds =
+      acceptedEventIds
+        .asSequence()
+        .map {
+          it.trim()
+        }
+        .filter {
+          it.isNotBlank()
+        }
+        .filter {
+          it in expectedIdSet
+        }
+        .distinct()
+        .toList()
+
+    if (validAcceptedIds.isNotEmpty()) {
+      markUploaded(
+        validAcceptedIds
+      )
+    }
+
+    val unconfirmedEventIds =
+      expectedEventIds.filterNot {
+        it in validAcceptedIds
+      }
+
+    Log.d(
+      LOG_TAG,
+      "Lot traité : " +
+        "attendus=${expectedEventIds.size}, " +
+        "confirmés=${validAcceptedIds.size}, " +
+        "nonConfirmés=${unconfirmedEventIds.size}"
+    )
+
+    if (unconfirmedEventIds.isNotEmpty()) {
+      Log.w(
+        LOG_TAG,
+        "Événements non confirmés : " +
+          unconfirmedEventIds.joinToString(
+            limit = 10
+          )
+      )
+
+      return BatchResult.retry(
+        confirmedCount =
+          validAcceptedIds.size
+      )
+    }
+
+    return BatchResult.success(
+      confirmedCount =
+        validAcceptedIds.size
+    )
+  }
+
+  private fun handleHttpFailure(
+    statusCode: Int,
+    responseBody: String?
+  ): BatchResult {
+    Log.e(
+      LOG_TAG,
+      "Échec HTTP Guardian : " +
+        "status=$statusCode, " +
+        "body=${responseBody.orEmpty()}"
+    )
+
+    return when {
+      statusCode == 401 ||
+        statusCode == 403 -> {
+        BatchResult.authRetry()
+      }
+
+      GuardianApiClient
+        .isRetryableStatus(
+          statusCode
+        ) -> {
+        BatchResult.retry()
+      }
+
+      statusCode in 400..499 -> {
+        BatchResult.failure()
+      }
+
+      else -> {
+        BatchResult.retry()
+      }
+    }
+  }
+
+  private fun parseAcceptedEventIds(
+    responseBody: String
+  ): List<String> {
+    val responseJson =
+      JSONObject(
+        responseBody
+      )
+
+    val acceptedArray =
+      responseJson.optJSONArray(
+        "acceptedEventIds"
+      )
+        ?: throw JSONException(
+          "Le champ acceptedEventIds est absent"
+        )
+
+    val acceptedIds =
+      mutableListOf<String>()
+
+    for (
+      index in 0 until acceptedArray.length()
+    ) {
+      val eventId =
+        acceptedArray
+          .optString(index)
+          .trim()
+
+      if (eventId.isNotBlank()) {
+        acceptedIds.add(
+          eventId
+        )
+      }
+    }
+
+    return acceptedIds
+  }
+
+  private fun refreshPendingCount() {
+    GuardianLocationEngine
+      .refreshPendingCount(
+        applicationContext
+      )
+  }

+      return
+    }
+
+    val zRatio =
+      abs(z) /
+        magnitude
+
+    val currentlyHorizontal =
+      zRatio >=
+        HORIZONTAL_Z_RATIO
+
+    if (currentlyHorizontal) {
+      if (horizontalStartedAtElapsed == null) {
+        horizontalStartedAtElapsed =
+          nowElapsed
+      }
+
+      val horizontalDuration =
+        nowElapsed -
+          (
+            horizontalStartedAtElapsed
+              ?: nowElapsed
+            )
+
+      if (
+        horizontalDuration >=
+        HORIZONTAL_MIN_DURATION_MS
+      ) {
+        horizontalAfterImpact =
+          true
+      }
+    } else {
+      horizontalStartedAtElapsed =
+        null
+
+      horizontalAfterImpact =
+        false
+    }
+  }

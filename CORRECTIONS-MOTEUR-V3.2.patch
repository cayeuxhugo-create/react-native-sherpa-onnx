+      }
+    } else {
+      recoverySampleCount =
+        0
+    }
+  }
+
+
+  private fun schedulePostImpactAnalysis() {
+    analysisRunnable?.let {
+      handler?.removeCallbacks(it)
+    }
+
+    val runnable =
+      object : Runnable {
+        override fun run() {

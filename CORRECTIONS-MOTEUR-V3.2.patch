-    private fun analyzePreRoll(
-        frames: Collection<FloatArray>,
-        ): PreRollMetrics {
-
-        if (frames.isEmpty()) {
-
-            return PreRollMetrics.EMPTY
-        }
-
-        val frameLevelsDbfs =
-            ArrayList<Float>(
-                frames.size
-            )
-
-        var absolutePeak =
-            0.0f
-
-        for (frame in frames) {
-
-            if (frame.isEmpty()) {
-                continue
-            }
-
-            val rms =
-                calculateRms(
-                    samples =
-                        frame,
-                )
-
-            val rmsDbfs =
-                linearToDbfs(
-                    value =
-                        rms,
-                )
-                    .coerceAtLeast(
-                        MIN_ANALYSIS_DBFS
-                    )
-
-            frameLevelsDbfs.add(
-                rmsDbfs
-            )
-
-            for (sample in frame) {
-
-                val absoluteValue =
-                    kotlin.math.abs(
-                        sample
-                    )
-
-                if (
-                    absoluteValue >
-                    absolutePeak
-                ) {
-
-                    absolutePeak =
-                        absoluteValue
-                }
-            }
-        }
-
-        if (frameLevelsDbfs.isEmpty()) {
-
-            return PreRollMetrics.EMPTY
-        }
-
-        val noiseDbfs =
-            percentile(
-                values =
-                    frameLevelsDbfs,
-
-                percentile =
-                    PRE_ROLL_NOISE_PERCENTILE,
-            )
-
-        val speechDbfs =
-            percentile(
-                values =
-                    frameLevelsDbfs,
-
-                percentile =
-                    PRE_ROLL_SPEECH_PERCENTILE,
-            )
-
-        val speechToNoiseDb =
-            (
-                speechDbfs -
-                    noiseDbfs
-            )
-                .coerceAtLeast(
-                    0.0f
-                )
-
-        val peakDbfs =
-            linearToDbfs(
-                value =
-                    absolutePeak,
-            )
-                .coerceAtLeast(
-                    MIN_ANALYSIS_DBFS
-                )
-
-        return PreRollMetrics(
-            speechDbfs =
-                speechDbfs,
-
-            noiseDbfs =
-                noiseDbfs,
-
-            peakDbfs =
-                peakDbfs,
-
-            speechToNoiseDb =
-                speechToNoiseDb,
-        )
-    }

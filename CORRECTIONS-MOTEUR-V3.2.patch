+  ): String? {
+    return try {
+      val packageInfo =
+        context.packageManager
+          .getPackageInfo(
+            context.packageName,
+            0
+          )
+
+      packageInfo.versionName
+        ?.trim()
+        ?.takeIf {
+          it.isNotBlank()
+        }
+    } catch (_: Exception) {
+      null
+    }
+  }

+
+    createPtiTable(
+      database
+    )
+
+    createVoiceTable(
+      database
+    )
+
+    createSosTable(
+      database
+    )
+
+    createServiceTable(
+  database
+   )
+
+    createServiceHealthTable(
+  database
+   )
+
+    createLocationIndexes(
+      database
+    )
+
+    createPtiIndexes(
+      database
+    )
+
+    createVoiceIndexes(
+      database
+    )
+
+    createSosIndexes(
+      database
+    )
+
+    createServiceIndexes(
+  database
+  )
+
+createServiceHealthIndexes(
+  database
+)
+  }
+
+  override fun onUpgrade(
+    database: SQLiteDatabase,
+    oldVersion: Int,
+    newVersion: Int
+  ) {
+    if (oldVersion < 2) {
+      migrateLocationsToVersion2(
+        database
+      )
+    }
+
+    if (oldVersion < 3) {
+      database.beginTransaction()
+
+      try {
+        createPtiTable(
+          database
+        )
+
+        createPtiIndexes(
+          database
+        )
+
+        database.setTransactionSuccessful()
+      } finally {
+        database.endTransaction()
+      }
+    }
+
+    if (oldVersion < 4) {
+      database.beginTransaction()
+
+      try {
+        createVoiceTable(
+          database
+        )
+
+        createVoiceIndexes(
+          database
+        )
+
+        database.setTransactionSuccessful()
+      } finally {
+        database.endTransaction()
+      }
+    }
+
+    if (oldVersion < 5) {
+      database.beginTransaction()
+
+      try {
+        createSosTable(
+          database
+        )
+
+        createSosIndexes(
+          database
+        )
+
+        database.setTransactionSuccessful()
+      } finally {
+        database.endTransaction()
+      }
+    }
+
+    if (oldVersion < 6) {
+  database.beginTransaction()
+
+  try {
+    createServiceTable(
+      database
+    )
+
+    createServiceIndexes(
+      database
+    )
+
+    database.setTransactionSuccessful()
+  } finally {
+    database.endTransaction()
+  }
+ }
+ 
+
+if (oldVersion < 7) {
+  database.beginTransaction()
+
+  try {
+    createServiceHealthTable(
+      database
+    )
+
+    createServiceHealthIndexes(
+      database
+    )
+
+    database.setTransactionSuccessful()
+  } finally {
+    database.endTransaction()
+  }
+}

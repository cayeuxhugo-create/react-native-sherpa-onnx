+  private fun getPendingCount(
+    tableName: String
+  ): Int {
+    readableDatabase.rawQuery(
+      """
+      SELECT COUNT(*)
+      FROM $tableName
+      WHERE uploaded = 0
+      """.trimIndent(),
+      null
+    ).use { cursor ->
+      return if (cursor.moveToFirst()) {
+        cursor.getInt(0)
+      } else {
+        0
+      }
+    }
+  }

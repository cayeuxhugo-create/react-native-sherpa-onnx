-    private data class PreRollMetrics(
-        val speechDbfs: Float?,
-        val noiseDbfs: Float?,
-        val peakDbfs: Float?,
-        val speechToNoiseDb: Float?,
-    ) {
-
-        companion object {
-
-            val EMPTY =
-                PreRollMetrics(
-                    speechDbfs =
-                        null,
-
-                    noiseDbfs =
-                        null,
-
-                    peakDbfs =
-                        null,
-
-                    speechToNoiseDb =
-                        null,

-    private fun calculateRms(
-        samples: FloatArray,
-    ): Float {
-
-        if (samples.isEmpty()) {
-            return 0.0f
-        }
-
-        var squaredSum =
-            0.0
-
-        for (sample in samples) {
-
-            val safeSample =
-                if (
-                    sample.isFinite()
-                ) {
-                    sample.toDouble()
-                } else {
-                    0.0
-                }
-
-            squaredSum +=
-                safeSample *
-                    safeSample
-        }
-
-        return sqrt(
-            squaredSum /
-                samples.size.toDouble()
-        )
-            .toFloat()
-    }
-
-    private fun calculatePeak(
-        samples: FloatArray,
-    ): Float {
-
-        var peak =
-            0.0f
-
-        for (sample in samples) {
-
-            if (!sample.isFinite()) {
-                continue
-            }
-
-            peak =
-                maxOf(
-                    peak,
-                    abs(sample)
-                )
-        }
-
-        return peak
-    }
-
-    private fun linearToDbfs(
-        value: Float,
-    ): Float {
-
-        val safeValue =
-            maxOf(
-                value,
-                MIN_MEASURABLE_LINEAR
-            )
-
-        return (
-            20.0 *
-                log10(
-                    safeValue.toDouble()
-                )
-            )
-            .toFloat()
-    }
-
-    private fun dbToLinear(
-        db: Float,
-    ): Float {
-
-        return 10.0
-            .pow(
-                db.toDouble() /
-                    20.0
-            )
-            .toFloat()
-    }
-
-    private fun interpolate(
-        previous: Float,
-        current: Float,
-        alpha: Float,
-    ): Float {
-
-        return previous +
-            (
-                current -
-                    previous
-            ) *
-            alpha
-    }
-
-    private fun percentile(
-        values: List<Float>,
-        percentile: Float,
-    ): Float {
-
-        require(
-            values.isNotEmpty()
-        )
-
-        val sorted =
-            values.sorted()
-
-        if (sorted.size == 1) {
-            return sorted[0]
-        }
-
-        val clampedPercentile =
-            percentile.coerceIn(
-                0.0f,
-                1.0f
-            )
-
-        val position =
-            clampedPercentile *
-                (
-                    sorted.size -
-                        1
-                    )
-
-        val lowerIndex =
-            position.toInt()
-
-        val upperIndex =
-            minOf(
-                lowerIndex + 1,
-                sorted.lastIndex
-            )
-
-        if (
-            lowerIndex ==
-            upperIndex
-        ) {
-            return sorted[
-                lowerIndex
-            ]
-        }
-
-        val fraction =
-            position -
-                lowerIndex.toFloat()
-
-        return sorted[
-            lowerIndex
-        ] +
-            (
-                sorted[
-                    upperIndex
-                ] -
-                    sorted[
-                        lowerIndex
-                    ]
-                ) *
-                fraction
-    }

+        when {
+          stillRatio >= 1.0 ->
+            40
+
+          stillRatio >= 0.75 ->
+            30
+
+          stillRatio >= 0.50 ->
+            20
+
+          stillRatio >= 0.25 ->
+            10
+
+          else ->
+            0
+        }
+    }

+  private fun createEventJson(
+    eventId: String,
+    eventType: GuardianEventType,
+    priority: GuardianEventPriority,
+    createdAt: Long,
+    recordedAt: Long,
+    schemaVersion: Int,
+    deviceJson: JSONObject,
+    payloadJson: JSONObject
+  ): JSONObject {
+    return JSONObject()
+      .put(
+        "eventId",
+        eventId
+      )
+      .put(
+        "eventType",
+        eventType.name
+      )
+      .put(
+        "priority",
+        priority.name
+          .lowercase(
+            Locale.ROOT
+          )
+      )
+      .put(
+        "createdAt",
+        createdAt
+      )
+      .put(
+        "recordedAt",
+        recordedAt
+      )
+      .put(
+        "device",
+        deviceJson
+      )
+      .put(
+        "payload",
+        payloadJson
+      )
+      .put(
+        "schemaVersion",
+        schemaVersion
+      )
+  }
+
+  private fun createEncodedBatch(
+    batchId: String,
+    sentAt: Long,
+    eventIds: List<String>,
+    eventsArray: JSONArray
+  ): EncodedBatch {
+    val requestJson =
+      JSONObject()
+        .put(
+          "batchId",
+          batchId
+        )
+        .put(
+          "sentAt",
+          sentAt
+        )
+        .put(
+          "events",
+          eventsArray
+        )
+
+    return EncodedBatch(
+      batchId =
+        batchId,
+
+      eventIds =
+        eventIds.toList(),
+
+      json =
+        requestJson.toString()
+    )
+  }

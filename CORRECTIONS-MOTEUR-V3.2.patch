-
-    private fun calculateRms(
-        samples: FloatArray,
-    ): Float {
-
-        if (samples.isEmpty()) {
-
-            return 0.0f
-        }
-
-        var squaredSum =
-            0.0
-
-        for (sample in samples) {
-
-            val value =
-                sample.toDouble()
-
-            squaredSum +=
-                value * value
-        }
-
-        return kotlin.math.sqrt(
-            squaredSum /
-                samples.size.toDouble()
-        )
-            .toFloat()
-    }
-
-    private fun linearToDbfs(
-        value: Float,
-    ): Float {
-
-        val safeValue =
-            value
-                .coerceAtLeast(
-                    MIN_MEASURABLE_LINEAR
-                )
-
-        return (
-            20.0 *

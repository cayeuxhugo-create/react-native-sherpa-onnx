+      val ptiResult =
+        uploadPendingPtiEvents(
+          config = config,
+          locationStore = locationStore
+        )
+
+      when (ptiResult) {
+        SyncResult.SUCCESS -> {
+          // Continuer avec les événements Voice.
+        }
+
+        SyncResult.RETRY -> {
+          refreshPendingCount()
+          return Result.retry()
+        }
+
+        SyncResult.FAILURE -> {
+          refreshPendingCount()
+          return Result.failure()

+            value
+                .coerceAtLeast(
+                    MIN_MEASURABLE_LINEAR
+                )
+
+        return (
+            20.0 *
+                kotlin.math.log10(
+                    safeValue.toDouble()
+                )
+            )
+            .toFloat()
+    }
+
+    private fun percentile(
+        values: List<Float>,
+        percentile: Float,
+    ): Float {
+
+        require(
+            values.isNotEmpty()
+        )
+
+        val sortedValues =
+            values.sorted()
+
+        if (
+            sortedValues.size ==
+            1
+        ) {
+
+            return sortedValues[0]
+        }
+
+        val safePercentile =
+            percentile.coerceIn(
+                0.0f,
+                1.0f,
+            )
+
+        val position =
+            safePercentile *
+                (
+                    sortedValues.size -
+                        1
+                    )
+
+        val lowerIndex =
+            kotlin.math.floor(
+                position.toDouble()
+            )
+                .toInt()
+
+        val upperIndex =
+            kotlin.math.ceil(
+                position.toDouble()
+            )
+                .toInt()
+
+        if (
+            lowerIndex ==
+            upperIndex
+        ) {
+
+            return sortedValues[
+                lowerIndex
+            ]
+        }
+
+        val fraction =
+            position -
+                lowerIndex.toFloat()
+
+        val lowerValue =
+            sortedValues[
+                lowerIndex
+            ]
+
+        val upperValue =
+            sortedValues[
+                upperIndex
+            ]
+
+        return lowerValue +
+            (
+                upperValue -
+                    lowerValue
+                ) *
+                fraction
+    }

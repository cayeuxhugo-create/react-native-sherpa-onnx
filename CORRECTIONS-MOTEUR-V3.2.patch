+
+    /*
+     * Un nouvel eventId est un véritable
+     * nouvel événement acoustique.
+     *
+     * On peut donc l'évaluer immédiatement.
+     */
+    val newFarVoiceEvent =
+        farVoiceAlive &&
+            safeFarVoiceEventId > 0L &&
+            safeFarVoiceEventId !=

+  private fun validateEventIdentity(
+    config: GuardianNativeConfig,
+    eventId: String,
+    childId: String,
+    familyId: String,
+    familyCode: String,
+    deviceId: String
+  ) {
+    require(
+      childId.isNotBlank() &&
+        familyId.isNotBlank() &&
+        familyCode.isNotBlank() &&
+        deviceId.isNotBlank()
+    ) {
+      "Identité incomplète pour l'événement $eventId"
+    }
+
+    val identityMatches =
+      childId ==
+        config.childId &&
+        familyId ==
+        config.familyId &&
+        familyCode ==
+        config.familyCode &&
+        deviceId ==
+        config.deviceId
+
+    require(
+      identityMatches
+    ) {
+      "Identité incohérente pour l'événement $eventId"
+    }
+  }

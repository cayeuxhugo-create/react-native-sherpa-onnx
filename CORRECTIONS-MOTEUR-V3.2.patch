+    fun reset() {
+
+        active =
+            false
+
+        
+        currentGainDb =
+            0.0f
+
+        estimatedSpeechDbfs =
+            DEFAULT_SPEECH_LEVEL_DBFS
+
+        estimatedNoiseDbfs =
+            DEFAULT_NOISE_LEVEL_DBFS
+
+        hasSpeechEstimate =
+            false
+
+        hasNoiseEstimate =
+            false
+
+        lastInputRmsDbfs =
+            null
+
+        lastOutputRmsDbfs =
+            null
+
+        lastInputPeakDbfs =

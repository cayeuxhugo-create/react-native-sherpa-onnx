-
-    return when {
-      statusCode == 401 ||
-        statusCode == 403 -> {
-        BatchResult.authRetry()
-      }
-
-      GuardianApiClient
-        .isRetryableStatus(
-          statusCode
-        ) -> {
-        BatchResult.retry()
-      }
-
-      statusCode in 400..499 -> {
-        BatchResult.failure()
-      }
-
-      else -> {
-        BatchResult.retry()
-      }
-    }
-  }

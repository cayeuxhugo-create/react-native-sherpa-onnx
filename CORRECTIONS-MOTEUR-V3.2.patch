+      nowElapsed
+
+    peakImpactG =
+      forceG
+
+    postImpactForceG =
+      forceG
+
+    stillStartedAtElapsed =
+      null
+
+    horizontalStartedAtElapsed =
+      null
+
+    horizontalAfterImpact =
+      false

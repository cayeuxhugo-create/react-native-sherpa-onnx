+    private var retryWaitingForFreshPairedEvidenceEventId = 0L
+
+    /*
+     * Diagnostic uniquement.
+     *
+     * Le FINAL ne contrôle plus le réarmement.
+     */
+    private var lastFinalizedAtMs =
+        0L
+
+    /*
+     * ========================================================================
+     * Guardian Speech Capture V3-C - Neural Speech Scout
+     * ========================================================================
+     *

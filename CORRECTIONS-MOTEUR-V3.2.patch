+        NOT NULL DEFAULT 'NORMAL'
+        """.trimIndent()
+      )
+
+      database.execSQL(
+        """
+        ALTER TABLE $TABLE_LOCATIONS
+        ADD COLUMN schema_version INTEGER
+        NOT NULL DEFAULT 1
+        """.trimIndent()
+      )
+
+      database.execSQL(
+        """
+        ALTER TABLE $TABLE_LOCATIONS
+        ADD COLUMN child_id TEXT
+        NOT NULL DEFAULT ''
+        """.trimIndent()
+      )
+
+      database.execSQL(
+        """
+        ALTER TABLE $TABLE_LOCATIONS
+        ADD COLUMN family_id TEXT
+        NOT NULL DEFAULT ''
+        """.trimIndent()
+      )
+
+      database.execSQL(
+        """
+        ALTER TABLE $TABLE_LOCATIONS
+        ADD COLUMN family_code TEXT
+        NOT NULL DEFAULT ''
+        """.trimIndent()
+      )
+
+      database.execSQL(
+        """
+        ALTER TABLE $TABLE_LOCATIONS
+        ADD COLUMN device_id TEXT
+        NOT NULL DEFAULT ''
+        """.trimIndent()
+      )
+
+      database.execSQL(
+        """
+        ALTER TABLE $TABLE_LOCATIONS
+        ADD COLUMN created_at INTEGER
+        NOT NULL DEFAULT 0
+        """.trimIndent()
+      )
+
+      database.execSQL(
+        """
+        UPDATE $TABLE_LOCATIONS
+        SET
+          created_at = location_timestamp,
+          uploaded = 1
+        WHERE child_id = ''
+           OR family_id = ''
+           OR device_id = ''
+        """.trimIndent()
+      )
+
+      createLocationIndexes(
+        database
+      )
+
+      database.setTransactionSuccessful()
+    } finally {
+      database.endTransaction()
+    }
+  }

+            decision =
+                GuardianAsrAdmissionDecision.WAIT,
+
+            reason =
+                "FAR_VOICE_EVENT_ALREADY_CONSUMED",
+
+            metrics =
+                PreRollMetrics.EMPTY,
+
+            acousticRms =
+                safeAcousticRms,
+
+            acousticNoiseFloorRms =
+                safeNoiseFloorRms,
+
+            snrDb =
+                safeSnrDb,
+
+            farVoiceEventId =
+                safeFarVoiceEventId,
+
+            farVoiceSource =

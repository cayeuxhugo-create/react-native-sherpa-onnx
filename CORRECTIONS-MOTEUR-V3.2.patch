+      calculateFallScore(
+        peakImpact =
+          peakImpactG
+            ?: currentForceG,
+
+        postImpactForce =
+          postImpactForceG,
+
+        horizontal =
+          horizontalAfterImpact,
+
+        stillDurationMs =
+          stillDurationMs,
+
+        requiredStillDurationMs =
+          requiredAnalysisDuration,
+
+        recoveryDetected =
+          recoveryDetected
+      )
+
